# Ignore Maven build files
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Ignore Gradle build files
.gradle
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IDE files
.idea/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

# OS files
.DS_Store
Thumbs.db

# Log files
*.log
logs/

# Application properties with sensitive data
application-local.properties
application-dev.properties
application-prod.properties

# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
